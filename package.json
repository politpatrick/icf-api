{
  "name": "icf-mcp",
  "version": "1.1.0",
  "description": "MCP-Server für die deutsche ICF und die ICD-10-GM",
  "private": true,
  "type": "module",
  "bin": {
    "icf-mcp": "src/server.mjs"
  },
  "files": [
    "src",
    "data/icf_flat.json",
    "data/qualifiers.json",
    "data/icd10gm.json"
  ],
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs",
    "build:data": "scripts/build_data.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/politpatrick/icf-api.git"
  },
  "keywords": ["icf", "icd-10-gm", "mcp", "model-context-protocol", "claude", "teilhabe", "sgb-ix"]
}
